# Server Configuration
HOST=0.0.0.0
PORT=8080
SESSION_TTL_SECS=86400
DEFAULT_LINK_TTL_SECS=10800
MAX_BODY_SIZE_BYTES=1048576

# Database & Cache (PostgreSQL 16 & Redis 7)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/money_movement
REDIS_URL=redis://localhost:6379

# Event Streaming (NATS JetStream)
NATS_URL=nats://localhost:4222

# Security & CORS (comma-separated origins or * for all)
CORS_ALLOWED_ORIGINS=*

# Business Caps (Paisa: 100 paisa = 1 BDT)
PER_TRANSFER_CAP_PAISA=5000000
DAILY_OUTFLOW_CAP_PAISA=20000000

# Transactional Email (Brevo SMTP - Optional / Silent no-op if omitted, R22)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM_EMAIL=no-reply@pstupay.local

# AI Intent Parser (Optional - fallback to deterministic offline grammar parser)
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
